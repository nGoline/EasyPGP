<?xml version="1.0" encoding="utf-8"?>
<!-- Only the checked row is filled. Given as a flat colour, Material paints every row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/nav_item_pill_selected" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
